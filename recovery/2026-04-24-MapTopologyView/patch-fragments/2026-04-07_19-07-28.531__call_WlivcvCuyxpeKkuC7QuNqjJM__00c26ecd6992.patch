+    const badgeLabel = hasMatch ? ALERT_LEVEL_LABELS[alertLevel] : '待映射'
+    const badgeBackground = hasMatch ? `${accentColor}cc` : 'rgba(15, 23, 42, 0.88)'
+    const badgeColor = hasMatch ? '#041014' : '#cbd5e1'
