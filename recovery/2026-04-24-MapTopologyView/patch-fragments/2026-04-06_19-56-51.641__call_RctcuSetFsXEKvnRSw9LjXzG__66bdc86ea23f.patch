+"""
+WE1 阶段 3 验证脚本：求解与覆盖层链路收口
+
+不依赖启动 HTTP 服务，直接调用后端服务层与路由函数。
+运行方式：
+    python backend/scripts/verify_we1_phase3.py
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from typing import Any, Dict, Iterable
+
+
+BACKEND_ROOT = Path(__file__).resolve().parents[1]
+if str(BACKEND_ROOT) not in sys.path:
+    sys.path.insert(0, str(BACKEND_ROOT))
+
+from app.routers.topology_simulation import (  # noqa: E402
+    SolveFailureRequest,
+    SolveSteadyRequest,
+    get_simulation_overlay,
+    solve_failure_api,
+    solve_steady_api,
+)
+from app.services.we1_pilot_service import (  # noqa: E402
+    get_we1_pilot_seed_or_raise,
+    list_we1_pilots,
+)
+
+
+def _assert_keys(data: Dict[str, Any], keys: Iterable[str], label: str) -> None:
+    missing = [key for key in keys if key not in data]
+    if missing:
+        raise AssertionError(f"{label} 缺少字段: {missing}")
+
+
+def _assert_overlay_shape(data: Dict[str, Any], label: str) -> None:
+    _assert_keys(
+        data,
+        ["pilot_id", "scenario_id", "solver_status", "iterations", "nodes", "edges", "summary"],
+        label,
+    )
+    if not data["nodes"]:
+        raise AssertionError(f"{label} 没有节点结果")
+    if not data["edges"]:
+        raise AssertionError(f"{label} 没有边结果")
+    if data["solver_status"] not in {"converged", "max_iter", "error"}:
+        raise AssertionError(f"{label} solver_status 非法: {data['solver_status']}")
+
+
+def main() -> None:
+    print("=== WE1 阶段3链路验证开始 ===")
+
+    pilots = list_we1_pilots()
+    if len(pilots) < 2:
+        raise AssertionError(f"WE1 pilot 数量异常: {len(pilots)}")
+    print(f"已发现 pilot: {[pilot['id'] for pilot in pilots]}")
+
+    for pilot in pilots:
+        seed_data = get_we1_pilot_seed_or_raise(pilot["id"])
+        scenarios = seed_data["seed"].get("scenarios", [])
+        if not scenarios:
+            raise AssertionError(f"{pilot['id']} seed 没有场景定义")
+        print(
+            f"[seed] {pilot['id']} -> seed={seed_data['seed_file']} "
+            f"scenarios={[scenario['id'] for scenario in scenarios]}"
+        )
+
+    steady_mainline = solve_steady_api(
+        SolveSteadyRequest(
+            pilot_id="mainline_zhongwei_jingbian",
+            scenario_id="steady_base",
+        )
+    )
+    _assert_overlay_shape(steady_mainline, "主样板 steady_base")
+    print(
+        "[steady] mainline_zhongwei_jingbian "
+        f"status={steady_mainline['solver_status']} "
+        f"nodes={len(steady_mainline['nodes'])} edges={len(steady_mainline['edges'])}"
+    )
+
+    failure_mainline = solve_failure_api(
+        SolveFailureRequest(
+            pilot_id="mainline_zhongwei_jingbian",
+            base_scenario_id="steady_base",
+            failure_node_id="WE1-76",
+            failure_type="compressor_offline",
+        )
+    )
+    _assert_overlay_shape(failure_mainline, "主样板 compressor_offline")
+    print(
+        "[failure] mainline_zhongwei_jingbian "
+        f"status={failure_mainline['solver_status']} "
+        f"alerts={failure_mainline['summary'].get('alert_count')}"
+    )
+
+    branch_overlay = get_simulation_overlay(
+        pilot_id="zhengzhou_xuedian_changlv",
+        scenario_id="steady_branch_base",
+    )
+    _assert_overlay_shape(branch_overlay, "辅样板 overlay")
+    _assert_keys(branch_overlay, ["meta"], "辅样板 overlay")
+    _assert_keys(
+        branch_overlay["meta"],
+        ["pilot_id", "scenario_id", "available_scenarios", "node_count", "edge_count"],
+        "辅样板 overlay.meta",
+    )
+    print(
+        "[overlay] zhengzhou_xuedian_changlv "
+        f"meta_nodes={branch_overlay['meta']['node_count']} "
+        f"meta_edges={branch_overlay['meta']['edge_count']}"
+    )
+
+    print("=== WE1 阶段3链路验证通过 ===")
+
+
+if __name__ == "__main__":
+    main()
