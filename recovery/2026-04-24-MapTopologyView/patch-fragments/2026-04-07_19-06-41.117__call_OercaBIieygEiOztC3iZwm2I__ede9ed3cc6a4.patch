+
+function resolveSimulationEdgeVisualStyle(
+    match: SimulationEdgeVisualMatch | null | undefined,
+    dimmed: boolean,
+): SimulationEdgeVisualStyle {
+    if (!match || match.matchedEdges.length === 0) {
+        return {
+            strokeColor: LINE_COLOR,
+            strokeWeight: LINE_WEIGHT,
+            strokeStyle: 'dashed',
+            strokeOpacity: dimmed ? 0.06 : 0.22,
+            zIndex: 90,
+        }
+    }
+
+    const strongestEdge = [...match.matchedEdges].sort((a, b) => b.utilization - a.utilization)[0]
+    const widthFactor = Math.max(...match.matchedEdges.map(item => item.width_factor))
+    const strokeOpacity = dimmed ? SIM_DIMMED_OPACITY : 0.96
+
+    return {
+        strokeColor: strongestEdge.color,
+        strokeWeight: Math.max(3, Math.min(10, Number((LINE_WEIGHT + widthFactor * 4).toFixed(2)))),
+        strokeStyle: match.highestAlertLevel === 'critical' ? 'dashed' : 'solid',
+        strokeOpacity,
+        zIndex: match.highestAlertLevel === 'critical' ? 145 : 130,
+    }
+}
