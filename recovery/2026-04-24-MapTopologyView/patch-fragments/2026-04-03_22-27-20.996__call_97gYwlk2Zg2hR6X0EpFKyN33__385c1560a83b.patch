 )
+
+function getNodeMetaLabel(node: PipelineNode): string {
+    const rawType = getNodeRawType(node)
+    switch (rawType) {
+        case 'source':
+            return '气源/首末站'
+        case 'compressor':
+            return '压气站'
+        case 'distribution':
+            return '分输站'
+        case 'valve':
+            return '阀室'
+        case 'junction':
+            return '交汇/枢纽'
+        default:
+            return node.pressureLevel || '未知类型'
+    }
+}
 
