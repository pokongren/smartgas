+function getRawStationType(node: PipelineNode): string {
+    const rawType = node.properties?.rawType
+    return typeof rawType === 'string' ? rawType : ''
+}
+
+function isCompressorNode(node: PipelineNode): boolean {
+    return (
+        getRawStationType(node) === 'compressor' ||
+        node.properties?.isCompressor === true ||
+        node.name.includes('压气站')
+    )
